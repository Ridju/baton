
int modulo(int a, int b) {
    return a - a/b * b;
}

int main() {
    int i = 1;

    while(i <= 20) {
        bool is_foo = modulo(i, 3) == 0;
        bool is_bar = modulo(i, 5) == 0;

        if(is_foo){
            if(is_bar) {
                print("FooBar");
            } else {
                print("Foo");
            }
        } else {
            if(is_bar) {
                print("Bar");
            } else {
                print(i);
            }
        }
        i = i + 1;
    }

    return 0;
}